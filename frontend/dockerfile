# Stage 1: Building the app
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files and install dependencies
COPY frontend/package*.json ./

# Install the exact locked dependencies needed to compile TypeScript.
RUN npm ci

# Copy the rest of the frontend code and build the app
COPY frontend/ .
ARG NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
RUN npm run build
RUN npm prune --omit=dev

# Stage 2: Set up the runtime environment
FROM node:20-alpine AS runner

# Create a non-root user and switch to it
RUN addgroup -g 1001 -S nodejs
RUN adduser -S nextjs -u 1001 -G nodejs

# Set permissions for the nextjs user
RUN mkdir -p /app/.next/cache/fetch-cache /app/.next/cache/images && \
    chown -R nextjs:nodejs /app/.next/cache


USER nextjs

WORKDIR /app


# Copy the built app and public assets from the builder stage
COPY --chown=nextjs:nodejs --from=builder /app/.next ./.next
COPY --chown=nextjs:nodejs --from=builder /app/public ./public
COPY --chown=nextjs:nodejs --from=builder /app/package*.json ./
COPY --chown=nextjs:nodejs --from=builder /app/node_modules ./node_modules

# Expose port 3000 for the app
EXPOSE 3000

# Command to run app
CMD ["npm", "start"]
