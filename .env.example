# Copy to .env and replace only the values needed for the controlled run.
# The repository default is loopback-only and all device writes are locked.
ALLOWED_SUBNET=127.0.0.1/32
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BACKEND_PORT=8000
FRONTEND_PORT=3000
BACKEND_PUBLIC_URL=http://127.0.0.1:8000
MAX_SCAN_HOSTS=1024
MAX_UPDATE_DEVICES=100
LOG_LEVEL=INFO

# Required before a real device scan. Never commit real values.
MAGEWELL_USERNAME=
MAGEWELL_PASSWORD=

# The one real-device effect boundary. Leave false for setup, checks, and scanning.
ENABLE_DEVICE_WRITES=false
